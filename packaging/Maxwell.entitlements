<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Voice mode hears you through the microphone. Under the hardened runtime macOS refuses the
       microphone to an app without this, and never shows the question. -->
  <key>com.apple.security.device.audio-input</key><true/>
</dict>
</plist>
