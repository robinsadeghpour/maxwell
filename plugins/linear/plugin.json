{
  "id": "linear",
  "name": "Linear",
  "version": "0.1.0",
  "description": "Each session's ticket and its status, \"ticket done\" in Safe to close, one-click status moves.",
  "protocol": 1,
  "run": [
    "./linear"
  ],
  "settings": [
    {
      "key": "api-key",
      "title": "API key",
      "type": "secret",
      "placeholder": "lin_api_…",
      "help": "Linear › Settings › Security & access › New API key."
    },
    {
      "key": "sync",
      "title": "Status moves",
      "type": "choice",
      "choices": [
        "suggest",
        "auto",
        "off"
      ],
      "default": "suggest",
      "help": "Suggest asks first. Auto moves tickets on its own."
    },
    {
      "key": "writes",
      "title": "Writes",
      "type": "choice",
      "choices": [
        "live",
        "dry-run"
      ],
      "default": "live",
      "help": "Dry run logs moves and comments instead of sending them."
    }
  ],
  "actions": [
    {
      "id": "open-ticket",
      "title": "Open Ticket in Linear",
      "scope": "session",
      "shortcut": "cmd+shift+o"
    },
    {
      "id": "move-started",
      "title": "Move Ticket to In Progress",
      "scope": "session"
    },
    {
      "id": "comment-pr",
      "title": "Comment the PR on the Ticket",
      "scope": "session"
    },
    {
      "id": "move-done",
      "title": "Move Ticket to Done",
      "scope": "session"
    },
    {
      "id": "refresh",
      "title": "Refresh Linear",
      "scope": "global"
    }
  ],
  "panels": [
    {
      "id": "tickets",
      "title": "Linear"
    }
  ]
}
